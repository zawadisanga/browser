# Server
NODE_ENV=production
PORT=16232

# Database
MONGODB_URI=mongodb://localhost:27017/zass
DATABASE_URL=postgresql://user:password@localhost:5432/zass
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-session-secret-key-change-this
ENCRYPTION_KEY=your-256-bit-encryption-key

# Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDGRID_API_KEY=your-sendgrid-api-key

# SMS
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
AFRICASTALKING_API_KEY=your-africastalking-key
AFRICASTALKING_USERNAME=sandbox

# Payment
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_PASSKEY=your-mpesa-passkey

# Cloud Storage
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=zass-storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path-to-key-file.json

# Monitoring
SENTRY_DSN=https://your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key
ELASTIC_APM_SERVER_URL=https://your-apm-server

# AI
OPENAI_API_KEY=sk-your-openai-key
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# Features
ENABLE_ADULT_CONTENT=true
ENABLE_VPN_PROXY=false
ENABLE_TOR=false
ENABLE_BLOCKCHAIN=false

# Rate Limits
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_BROWSER=100
RATE_LIMIT_SEARCH=50
RATE_LIMIT_DOWNLOAD=30

# Limits
MAX_FILE_SIZE=2147483648
MAX_USER_STORAGE=53687091200
MAX_TOTAL_STORAGE=10995116277760
MAX_CONCURRENT_BROWSERS=20
MAX_DOWNLOADS_PER_DAY=500
MAX_POSTS_PER_DAY=100
MAX_MESSAGES_PER_DAY=1000
