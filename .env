# Server
NODE_ENV=production
PORT=16232

# Database
MONGODB_URI=mongodb://localhost:27017/zass
DATABASE_URL=postgresql://user:password@localhost:5432/zass
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-session-secret-key-change-this
ENCRYPTION_KEY=your-256-bit-encryption-key

# Auth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SENDGRID_API_KEY=your-sendgrid-api-key

# SMS
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
AFRICASTALKING_API_KEY=your-africastalking-key
AFRICASTALKING_USERNAME=sandbox

# Payment
STRIPE_SECRET_KEY=sk_live_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_PASSKEY=your-mpesa-passkey

# Cloud Storage
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=zass-storage
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path-to-key-file.json

# Monitoring
SENTRY_DSN=https://your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-key
ELASTIC_APM_SERVER_URL=https://your-apm-server

# AI
OPENAI_API_KEY=sk-your-openai-key
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# Features
ENABLE_ADULT_CONTENT=true
ENABLE_VPN_PROXY=false
ENABLE_TOR=false
ENABLE_BLOCKCHAIN=false

# Rate Limits
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_BROWSER=100
RATE_LIMIT_SEARCH=50
RATE_LIMIT_DOWNLOAD=30

# Limits
MAX_FILE_SIZE=2147483648
MAX_USER_STORAGE=53687091200
MAX_TOTAL_STORAGE=10995116277760
MAX_CONCURRENT_BROWSERS=20
MAX_DOWNLOADS_PER_DAY=500
MAX_POSTS_PER_DAY=100
MAX_MESSAGES_PER_DAY=1000


# ============================================
# ZASS ENTERPRISE ECOSYSTEM - PRODUCTION ENV
# ============================================

# ------------------- SERVER -------------------
NODE_ENV=production
PORT=16232
HOST=0.0.0.0
APP_URL=https://zass.website
API_URL=https://api.zass.website
FRONTEND_URL=https://zass.website

# ------------------- DATABASES -------------------
# MongoDB
MONGODB_URI=mongodb://localhost:27017/zass?authSource=admin
MONGODB_USER=zass_admin
MONGODB_PASSWORD=secure_password_here
MONGODB_DATABASE=zass
MONGODB_REPLICA_SET=rs0

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=zass
PGUSER=zass_user
PGPASSWORD=secure_password_here

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=secure_redis_password
REDIS_CLUSTER_ENABLED=false

# ------------------- SECURITY -------------------
JWT_SECRET=super-secret-jwt-key-change-this-32-chars-minimum
JWT_REFRESH_SECRET=super-secret-refresh-key-change-this
SESSION_SECRET=super-secret-session-key
ENCRYPTION_KEY=32-byte-encryption-key-here
CSRF_SECRET=csrf-secret-key

# Argon2 Password Hashing
ARGON2_MEMORY=4096
ARGON2_TIME=3
ARGON2_PARALLELISM=1

# ------------------- AUTH PROVIDERS -------------------
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-secret

# Twitter/X OAuth
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-secret
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-secret

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-secret

# ------------------- EMAIL -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

SENDGRID_API_KEY=your-sendgrid-key
MAILGUN_API_KEY=your-mailgun-key
MAILGUN_DOMAIN=mg.zass.website

ADMIN_EMAIL=admin@zass.website
SUPPORT_EMAIL=support@zass.website
NOREPLY_EMAIL=noreply@zass.website

# ------------------- SMS -------------------
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

AFRICASTALKING_API_KEY=your-africastalking-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=ZASS

VONAGE_API_KEY=your-vonage-key
VONAGE_API_SECRET=your-vonage-secret

# ------------------- PAYMENT GATEWAYS -------------------
# Stripe
STRIPE_PUBLIC_KEY=pk_live_your-key
STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=live

# Razorpay
RAZORPAY_KEY_ID=rzp_live_your-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-key
FLUTTERWAVE_ENCRYPTION_KEY=your-encryption-key

# M-Pesa (Tanzania)
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=174379
MPESA_ENV=production

# Tigo Pesa
TIGO_API_KEY=your-tigo-key
TIGO_API_SECRET=your-tigo-secret

# Airtel Money
AIRTEL_CLIENT_ID=your-airtel-id
AIRTEL_CLIENT_SECRET=your-airtel-secret

# ------------------- CLOUD STORAGE -------------------
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=eu-west-1
AWS_S3_BUCKET=zass-production
AWS_S3_BACKUP_BUCKET=zass-backups
AWS_CLOUDFRONT_DOMAIN=https://d123.cloudfront.net

# Google Cloud Storage
GCS_PROJECT_ID=your-project-id
GCS_PRIVATE_KEY=your-private-key
GCS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GCS_BUCKET=zass-production

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Imgur
IMGUR_CLIENT_ID=your-imgur-id
IMGUR_CLIENT_SECRET=your-imgur-secret

# ImageKit
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/zass

# ------------------- AI & ML -------------------
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=org-your-org-id
OPENAI_MODEL=gpt-4-turbo

# Hugging Face
HUGGINGFACE_API_KEY=hf_your-key
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct

# Pinecone (Vector Database)
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX=zass

# Qdrant
QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-key

# ChromaDB
CHROMA_URL=http://localhost:8000
CHROMA_TENANT=default_tenant

# ------------------- MONITORING -------------------
# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# New Relic
NEW_RELIC_LICENSE_KEY=your-newrelic-key
NEW_RELIC_APP_NAME=ZASS-Ecosystem
NEW_RELIC_LOG_LEVEL=info

# Elastic APM
ELASTIC_APM_SERVER_URL=https://your-apm-server:8200
ELASTIC_APM_SECRET_TOKEN=your-secret-token
ELASTIC_APM_SERVICE_NAME=zass-api

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# ------------------- RATE LIMITS -------------------
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
RATE_LIMIT_BROWSER=100
RATE_LIMIT_SEARCH=50
RATE_LIMIT_DOWNLOAD=30
RATE_LIMIT_API=200
RATE_LIMIT_ADMIN=100

# ------------------- FILE LIMITS -------------------
MAX_FILE_SIZE=2147483648
MAX_USER_STORAGE=53687091200
MAX_TOTAL_STORAGE=10995116277760
MAX_UPLOAD_FILES=50
ALLOWED_FILE_TYPES=image/*,video/*,audio/*,application/pdf,application/zip

# ------------------- BROWSER SETTINGS -------------------
BROWSER_HEADLESS=true
BROWSER_MAX_CONCURRENT=20
BROWSER_TIMEOUT=30000
BROWSER_BLOCK_ADS=true
BROWSER_BLOCK_TRACKERS=true
BROWSER_USER_AGENT_ROTATION=true

# ------------------- FEATURE FLAGS -------------------
ENABLE_ADULT_CONTENT=true
ENABLE_VPN_PROXY=false
ENABLE_TOR=false
ENABLE_BLOCKCHAIN=false
ENABLE_NFT=false
ENABLE_2FA=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_PWA=true
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# ------------------- CACHE SETTINGS -------------------
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600
CACHE_MAX_KEYS=100000
REDIS_CACHE_ENABLED=true

# ------------------- LOGGING -------------------
LOG_LEVEL=info
LOG_DIRECTORY=./logs
LOG_MAX_FILES=30d
LOG_MAX_SIZE=20m
LOG_FORMAT=json

# ------------------- BACKUP -------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=true

# ------------------- SSL -------------------
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/zass.crt
SSL_KEY_PATH=/etc/nginx/ssl/zass.key
SSL_CA_PATH=/etc/nginx/ssl/ca.crt

# ------------------- CDN -------------------
CDN_ENABLED=true
CDN_URL=https://cdn.zass.website
CDN_PURGE_TOKEN=your-purge-token

# ------------------- WEBHOOKS -------------------
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=5000

# ------------------- QUEUE -------------------
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5000
QUEUE_CONCURRENCY=10
QUEUE_REMOVE_ON_COMPLETE=true

# ------------------- TANZANIA SPECIFIC -------------------
COUNTRY=TZ
CURRENCY=TZS
TIMEZONE=Africa/Dar_es_Salaam
LANGUAGE=sw
LOCALE=sw-TZ

# ------------------- DANGEROUS (DON'T CHANGE UNLESS YOU KNOW) -------------------
TRUST_PROXY=true
JSON_LIMIT=50mb
URLENCODED_LIMIT=50mb
REQUEST_TIMEOUT=120000
