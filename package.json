  "vitest": {
    "environment": "node",
    "coverage": {
      "provider": "v8",
      "reporter": ["text", "json", "html", "lcov"],
      "exclude": ["src/types/**", "src/__tests__/**", "dist/**"]
    },
    "include": ["src/**/*.{test,spec}.{js,ts}"],
    "exclude": ["node_modules", "dist"],
    "testTimeout": 30000,
    "threads": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "pnpm run type-check && pnpm run test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
