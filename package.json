{
  "name": "zass-master-ecosystem",
  "version": "20.0.0",
  "description": "👑 THE ULTIMATE ENTERPRISE PLATFORM - World-Class Browser, Social, Media, AI, Chat, Downloads - Zero Limits, Zero Censorship",
  "author": "ZASS Master Technology",
  "license": "Commercial",
  "private": true,
  "main": "dist/server.js",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "yarn": ">=1.22.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:debug": "tsx --inspect watch src/server.ts",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:copy",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy": "cp -r src/public dist/ && cp -r src/views dist/",
    "build:docker": "docker build -t zass-enterprise:latest .",
    "clean": "rm -rf dist/ coverage/ logs/ temp/",
    "prod": "NODE_ENV=production node dist/server.js",
    "prod:cluster": "NODE_ENV=production node dist/cluster.js",
    "worker": "tsx src/workers/queueWorker.ts",
    "worker:ai": "tsx src/workers/aiWorker.ts",
    "worker:video": "tsx src/workers/videoWorker.ts",
    "worker:email": "tsx src/workers/emailWorker.ts",
    "worker:backup": "tsx src/workers/backupWorker.ts",
    "worker:monitor": "tsx src/workers/monitorWorker.ts",
    "cron": "tsx src/workers/cronJobs.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:undo": "tsx src/scripts/migrate.ts undo",
    "seed": "tsx src/scripts/seed.ts",
    "seed:prod": "NODE_ENV=production tsx src/scripts/seed.ts",
    "backup": "tsx src/scripts/backup.ts",
    "backup:full": "tsx src/scripts/backup.ts --full",
    "restore": "tsx src/scripts/restore.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "artillery run tests/load/config.yml",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:build": "docker-compose -f docker-compose.yml build --no-cache",
    "docker:logs": "docker-compose -f docker-compose.yml logs -f",
    "docker:clean": "docker-compose -f docker-compose.yml down -v && docker system prune -af",
    "k8s:deploy": "kubectl apply -f k8s/",
    "k8s:rollback": "kubectl rollout undo deployment/zass-api",
    "k8s:logs": "kubectl logs -f deployment/zass-api",
    "terraform:plan": "cd terraform && terraform plan",
    "terraform:apply": "cd terraform && terraform apply -auto-approve",
    "terraform:destroy": "cd terraform && terraform destroy -auto-approve",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "grafana:start": "docker-compose -f docker-compose.monitoring.yml up -d",
    "grafana:stop": "docker-compose -f docker-compose.monitoring.yml down",
    "security:audit": "npm audit --production",
    "security:scan": "snyk test",
    "security:fix": "npm audit fix",
    "docs:generate": "typedoc --out docs/api src/",
    "docs:serve": "npx serve docs",
    "release": "standard-version",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch"
  },
