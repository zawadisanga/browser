{
  "name": "zass-enterprise-ecosystem",
  "version": "15.0.0",
  "description": "🏆 ULTIMATE ENTERPRISE All-in-One Platform: Browser, Social, Media, AI Search, Chat, Downloads - No Limits, No Censorship",
  "author": "ZASS Ecosystem",
  "license": "MIT",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "prod": "NODE_ENV=production node server.js",
    "prod:cluster": "NODE_ENV=production node cluster.js",
    "worker": "node workers/queueWorker.js",
    "worker:email": "node workers/emailWorker.js",
    "worker:video": "node workers/videoWorker.js",
    "worker:scrape": "node workers/scrapingWorker.js",
    "worker:ai": "node workers/aiWorker.js",
    "worker:backup": "node workers/backupWorker.js",
    "cron": "node workers/cronJobs.js",
    "migrate": "node scripts/migrate.js",
    "migrate:undo": "node scripts/migrate.js undo",
    "seed": "node scripts/seed.js",
    "seed:all": "node scripts/seed.js --all",
    "backup": "node scripts/backup.js",
    "backup:full": "node scripts/backup.js --full",
    "restore": "node scripts/restore.js",
    "test": "jest --coverage --verbose",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:clean && npm run build:css && npm run build:js && npm run build:ts",
    "build:clean": "rm -rf dist/",
    "build:css": "sass public/css/main.scss dist/css/main.css --style compressed --no-source-map",
    "build:css:watch": "sass public/css/main.scss dist/css/main.css --watch",
    "build:js": "webpack --mode production --config webpack.config.js",
    "build:js:dev": "webpack --mode development --config webpack.config.js",
    "build:ts": "tsc --project tsconfig.json",
    "build:all": "npm run build",
    "watch": "npm run build:css:watch & npm run build:js:dev & nodemon",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build --no-cache",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup",
    "nginx:reload": "sudo nginx -s reload",
    "nginx:restart": "sudo systemctl restart nginx",
    "nginx:status": "sudo systemctl status nginx",
    "ssl:renew": "sudo certbot renew",
    "ssl:generate": "sudo certbot certonly --nginx -d zass.website -d www.zass.website",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "update": "npm update --save && npm audit fix",
    "security:check": "npm audit",
    "security:fix": "npm audit fix",
    "info": "node scripts/system-info.js",
    "health": "curl http://localhost:16232/health",
    "metrics": "curl http://localhost:16232/metrics"
  },
