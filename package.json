{
  "name": "zass-mega-ecosystem",
  "version": "10.0.0",
  "description": "ULTIMATE All-in-One Platform: Browser, Social, Media, AI Search, Chat, Downloads - Everything Unlimited",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "heroku-postbuild": "npm install --production=false && npm run build:all",
    "build:all": "npm run build:css && npm run build:js || echo 'Build skipped'",
    "build:css": "sass public/css/main.scss public/css/main.css --style compressed --no-source-map || echo 'CSS build skipped'",
    "build:js": "webpack --mode production --config webpack.config.js || echo 'JS build skipped'",
    "worker": "node workers/queueWorker.js",
    "worker:email": "node workers/emailWorker.js",
    "worker:video": "node workers/videoWorker.js",
    "worker:scrape": "node workers/scrapingWorker.js",
    "cron": "node workers/cronJobs.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "mongoose": "^8.0.0",
    "redis": "^4.6.10",
    "bull": "^4.11.5",
    "bull-board": "^4.6.0",
    "puppeteer": "^21.6.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "playwright": "^1.40.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "ytdl-core": "^4.19.2",
    "fluent-ffmpeg": "^2.1.2",
    "ffmpeg-static": "^5.2.0",
    "spotify-web-api-node": "^5.0.2",
    "twitter-api-v2": "^1.15.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-facebook": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "express-validator": "^7.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "handlebars": "^4.7.8",
    "ejs": "^3.1.9",
    "pug": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "redux": "^4.2.1",
    "redux-thunk": "^3.1.0",
    "socket.io-client": "^4.6.1",
    "chart.js": "^4.4.0",
    "d3": "^7.8.5",
    "three": "^0.160.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs-node": "^4.15.0",
    "natural": "^6.11.0",
    "langchain": "^0.0.200",
    "openai": "^4.20.0",
    "chromadb": "^1.5.0",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "@sentry/node": "^7.80.0",
    "prom-client": "^15.0.0",
    "stripe": "^14.6.0",
    "uuid": "^9.0.1",
    "slugify": "^1.6.6",
    "dompurify": "^3.0.6",
    "xss": "^1.0.14",
    "sanitize-html": "^2.11.0",
    "html-to-text": "^9.0.5",
    "markdown-it": "^14.0.0",
    "marked": "^11.0.0",
    "archiver": "^6.0.1",
    "csv-parser": "^3.0.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "sass": "^1.69.5",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}

