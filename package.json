{
  "name": "zass-infinity-ecosystem",
  "version": "99.99.99",
  "description": "THE ULTIMATE ALL-IN-ONE PLATFORM - Contains EVERY package ever created. Browser, AI, Blockchain, Games, Social, Media, Chat, Search, Downloader, and EVERYTHING imaginable!",
  "author": "ZASS Ecosystem",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "cluster": "node cluster.js",
    "worker": "node workers/queueWorker.js",
    "worker:email": "node workers/emailWorker.js",
    "worker:video": "node workers/videoWorker.js",
    "worker:audio": "node workers/audioWorker.js",
    "worker:image": "node workers/imageWorker.js",
    "worker:scrape": "node workers/scrapingWorker.js",
    "worker:backup": "node workers/backupWorker.js",
    "worker:analytics": "node workers/analyticsWorker.js",
    "worker:notification": "node workers/notificationWorker.js",
    "cron": "node workers/cronJobs.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "build": "npm run build:all",
    "build:css": "sass public/css/main.scss public/css/main.css --style compressed",
    "build:js": "webpack --mode production --config webpack.config.js",
    "build:ts": "tsc",
    "build:react": "vite build",
    "build:next": "next build",
    "build:nuxt": "nuxt build",
    "build:all": "concurrently \"npm run build:css\" \"npm run build:js\" \"npm run build:ts\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "k8s:apply": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "nginx:start": "sudo systemctl start nginx",
    "nginx:stop": "sudo systemctl stop nginx",
    "nginx:reload": "sudo nginx -s reload",
    "ssl:renew": "certbot renew",
    "deploy:heroku": "git push heroku main",
    "deploy:aws": "aws deploy push --application-name zass --s3-location s3://zass-deploy",
    "deploy:gcp": "gcloud app deploy",
    "deploy:azure": "az webapp deployment source config-zip --resource-group zass --name zass --src deploy.zip",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:cloudflare": "wrangler publish",
    "clean": "rimraf node_modules package-lock.json && npm install"
  },
