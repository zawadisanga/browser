  "peerDependencies": {},
  "overrides": {
    "puppeteer": {
      "chromium": "latest"
    }
  },
  "resolutions": {
    "**/puppeteer": "^22.10.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": ["./tests/setup.js"],
    "verbose": true,
    "testTimeout": 30000
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "keywords": [
    "browser",
    "web-browser",
    "proxy-browser",
    "unlimited-browser",
    "video-downloader",
    "youtube-downloader",
    "tiktok-downloader",
    "instagram-downloader",
    "social-media",
    "chat",
    "ai-chatbot",
    "web-scraper",
    "search-engine",
    "file-upload",
    "cloud-storage",
    "enterprise",
    "production-ready",
    "scalable",
    "high-performance"
