{
  "name": "zass-god-mode-ecosystem",
  "version": "99.0.0",
  "description": "👑 THE ABSOLUTE ULTIMATE PLATFORM - Universal Browser, Quantum AI, Neural Network, Blockchain, Metaverse, Everything - ZERO LIMITS",
  "author": "ZASS God Mode Technologies",
  "license": "Proprietary",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0",
    "pnpm": ">=9.0.0",
    "bun": ">=1.1.0",
    "deno": ">=1.44.0"
  },
  "packageManager": "bun@1.1.8",
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "dev:hot": "bun --hot src/index.ts",
    "build": "bun run build:all",
    "build:all": "bun run clean && bun run build:ts && bun run build:web && bun run build:mobile && bun run build:desktop",
    "build:ts": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap",
    "build:web": "bun build src/web/index.ts --outdir dist/web --target browser --minify --splitting",
    "build:mobile": "bun build src/mobile/index.ts --outdir dist/mobile --target bun --minify",
    "build:desktop": "bun build src/desktop/index.ts --outdir dist/desktop --target bun --minify",
    "build:docker": "docker build -t zass-god-mode:latest -f Dockerfile.godmode .",
    "clean": "rm -rf dist/ coverage/ logs/ temp/ .next/ out/",
    "prod": "NODE_ENV=production bun run dist/index.js",
    "prod:cluster": "NODE_ENV=production bun run dist/cluster.js",
    "worker": "bun run src/workers/index.ts",
    "worker:ai": "bun run src/workers/aiWorker.ts",
    "worker:quantum": "bun run src/workers/quantumWorker.ts",
    "worker:neural": "bun run src/workers/neuralWorker.ts",
    "worker:blockchain": "bun run src/workers/blockchainWorker.ts",
    "worker:metaverse": "bun run src/workers/metaverseWorker.ts",
    "cron": "bun run src/workers/cronJobs.ts",
    "migrate": "bun run src/scripts/migrate.ts",
    "seed": "bun run src/scripts/seed.ts",
    "backup": "bun run src/scripts/backup.ts",
    "backup:full": "bun run src/scripts/backup.ts --full",
    "restore": "bun run src/scripts/restore.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:load": "bun run src/scripts/loadTest.ts",
    "test:chaos": "bun run src/scripts/chaosTest.ts",
    "lint": "bunx @biomejs/biome lint src/",
    "lint:fix": "bunx @biomejs/biome lint --fix src/",
    "format": "bunx @biomejs/biome format --write src/",
    "type-check": "bunx tsc --noEmit",
    "prepare": "bun run build",
    "docker:up": "docker-compose -f docker-compose.godmode.yml up -d",
    "docker:down": "docker-compose -f docker-compose.godmode.yml down",
    "docker:build": "docker-compose -f docker-compose.godmode.yml build",
    "k8s:deploy": "kubectl apply -f k8s-godmode/",
    "k8s:scale": "kubectl scale --replicas=100 deployment/zass-api",
    "k8s:rollback": "kubectl rollout undo deployment/zass-api",
    "aws:deploy": "aws cloudformation deploy --template-file cloudformation.yml --stack-name zass-godmode",
    "aws:destroy": "aws cloudformation delete-stack --stack-name zass-godmode",
    "gcp:deploy": "gcloud run deploy zass-godmode --source . --platform managed",
    "azure:deploy": "az webapp up --name zass-godmode --runtime NODE:22-lts",
    "pm2:start": "pm2 start ecosystem.godmode.config.js",
    "pm2:stop": "pm2 stop ecosystem.godmode.config.js",
    "pm2:logs": "pm2 logs",
    "grafana:start": "docker-compose -f docker-compose.monitoring.yml up -d",
    "security:scan": "bunx snyk test",
    "security:fix": "bunx snyk fix",
    "docs:generate": "bunx typedoc --out docs src/",
    "release": "bun run build && bun run test && bun run security:scan",
    "update:all": "bun update --latest"
  },
