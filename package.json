{
  "name": "zass-mega-ecosystem",
  "version": "15.0.0",
  "description": "ULTIMATE Enterprise Platform: AI-Powered Browser, Social Media Suite, Streaming, Downloads, E-commerce, Analytics - Complete Digital Ecosystem",
  "license": "UNLICENSED",
  "private": true,
  "author": "ZASS Technologies",
  "homepage": "https://zass-ecosystem.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zass/mega-ecosystem"
  },
  "keywords": [
    "browser",
    "social-media",
    "ai-search",
    "chat",
    "downloads",
    "streaming",
    "ecommerce",
    "analytics",
    "automation",
    "web-scraping",
    "video-processing",
    "ai-ml",
    "real-time",
    "microservices"
  ],
  "main": "dist/server.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "NODE_ENV=development nodemon --exec ts-node src/server.ts",
    "dev:cluster": "NODE_ENV=development node cluster.js",
    "build": "npm run clean && npm run build:ts && npm run build:copy && npm run build:css && npm run build:js && npm run build:manifest",
    "build:ts": "tsc",
    "build:copy": "copyfiles -u 1 src/views/**/* dist/ && copyfiles -u 1 src/public/**/* dist/",
    "build:css": "sass src/public/css/main.scss dist/public/css/main.css --style compressed --no-source-map",
    "build:js": "webpack --mode production --config webpack.config.js",
    "build:manifest": "node scripts/generate-manifest.js",
    "clean": "rimraf dist",
    "postinstall": "npm run build",
    "prestart": "npm run build",
    "preprod": "npm run build",
    "prod": "NODE_ENV=production node cluster.js",
    "prod:pm2": "pm2 start ecosystem.config.js --env production",
    "prod:docker": "docker-compose -f docker-compose.prod.yml up -d",
    "start:microservices": "node scripts/start-microservices.js",
    "worker:main": "node dist/workers/mainWorker.js",
    "worker:email": "node dist/workers/emailWorker.js",
    "worker:video": "node dist/workers/videoWorker.js",
    "worker:scrape": "node dist/workers/scrapingWorker.js",
    "worker:ai": "node dist/workers/aiWorker.js",
    "worker:social": "node dist/workers/socialWorker.js",
    "worker:payment": "node dist/workers/paymentWorker.js",
    "worker:image": "node dist/workers/imageWorker.js",
    "worker:backup": "node dist/workers/backupWorker.js",
    "cron:all": "node dist/cron/allJobs.js",
    "cron:cleanup": "node dist/cron/cleanupJobs.js",
    "cron:backup": "node dist/cron/backupJobs.js",
    "cron:analytics": "node dist/cron/analyticsJobs.js",
    "migrate:up": "node dist/database/migrate.js up",
    "migrate:down": "node dist/database/migrate.js down",
    "migrate:latest": "node dist/database/migrate.js latest",
    "seed:all": "node dist/database/seeds/index.js",
    "seed:dev": "NODE_ENV=development node dist/database/seeds/devSeed.js",
    "backup:full": "node dist/scripts/fullBackup.js",
    "backup:incremental": "node dist/scripts/incrementalBackup.js",
    "restore": "node dist/scripts/restore.js",
    "test": "NODE_ENV=test jest --coverage --detectOpenHandles --forceExit",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration --coverage --runInBand",
    "test:e2e": "jest --testPathPattern=e2e --runInBand --forceExit",
    "test:watch": "jest --watch",
    "test:load": "artillery run test/load/load-test.yml",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "type-check": "tsc --noEmit",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "audit": "npm audit && snyk test",
    "security": "npm run audit && node scripts/security-check.js",
    "docs:generate": "typedoc --out docs/api src/ && swagger-cli validate swagger.yaml",
    "docs:serve": "http-server docs -p 8080",
    "benchmark": "node scripts/benchmark.js",
    "profile": "node --prof dist/server.js && node --prof-process isolate-*.log > profile.txt",
    "logs:tail": "tail -f logs/combined.log",
    "logs:error": "tail -f logs/error.log",
    "monitor": "node scripts/monitor.js",
    "health": "curl http://localhost:3000/health | jq",
    "metrics": "curl http://localhost:3000/metrics | jq",
    "db:connect": "node scripts/dbConnect.js",
    "db:repair": "node scripts/dbRepair.js",
    "db:optimize": "node scripts/dbOptimize.js",
    "redis:flush": "redis-cli FLUSHALL",
    "cache:clear": "node scripts/clearCache.js",
    "queue:clean": "node scripts/cleanQueues.js",
    "update:all": "npm update && npm audit fix --force",
    "update:deps": "npx npm-check-updates -u && npm install",
    "docker:build": "docker build -t zass-mega-ecosystem:latest .",
    "docker:build:prod": "docker build -f Dockerfile.prod -t zass-mega-ecosystem:prod .",
    "docker:up": "docker-compose up -d",
    "docker:up:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker-compose down",
    "docker:down:volumes": "docker-compose down -v",
    "docker:logs": "docker-compose logs -f",
    "docker:prune": "docker system prune -f",
    "kubernetes:apply": "kubectl apply -f k8s/",
    "kubernetes:delete": "kubectl delete -f k8s/",
    "kubernetes:rollout": "kubectl rollout restart deployment/zass-ecosystem",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "nginx:reload": "sudo nginx -s reload",
    "nginx:test": "sudo nginx -t",
    "deploy:staging": "node scripts/deploy-staging.js",
    "deploy:production": "node scripts/deploy-production.js",
    "rollback": "node scripts/rollback.js",
    "maintenance:on": "node scripts/maintenance-mode.js on",
    "maintenance:off": "node scripts/maintenance-mode.js off",
    "ssl:renew": "certbot renew --nginx"
  },
